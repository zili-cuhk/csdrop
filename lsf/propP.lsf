#!/bin/bash
# Proposed method at the true tau (PROP_TRUE) and under working independence
# (PROP_T00) on P01-P36: 36 cells x 100 chunks of 5 reps = 3600 tasks.
# LSF arrays are limited to 1000 elements, so submit four times with an offset:
#   for o in 0 900 1800 2700; do OFFSET=$o bsub < lsf/propP.lsf; done
# (bsub passes OFFSET from the submission shell to the job.)
#BSUB -J propP[1-900]
#BSUB -q medium
#BSUB -W 24:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/propP.%J.%I.out
#BSUB -e logs/propP.%J.%I.err
TASK=$((${LSB_JOBINDEX:-1} + ${OFFSET:-0}))
module load matlab/R2025b
MARK=logs/propP.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_prop_fits($TASK, @fit_prop_adapter, 'exp', 'P', 'chunk', 5); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
