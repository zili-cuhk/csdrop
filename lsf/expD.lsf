#!/bin/bash
# Experiment E (strong signals): tau-dependent dropout effect; n in {600,2000,5000} x 200 reps, tau in {-0.3,...,0.5}; 80 tasks.
#BSUB -J expD[1-80]
#BSUB -q short
#BSUB -W 3:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/expD.%J.%I.out
#BSUB -e logs/expD.%J.%I.err
module load matlab/R2025b
TASK=$LSB_JOBINDEX
MARK=logs/expD.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_expD_fits($TASK); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
