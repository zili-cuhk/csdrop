#!/bin/bash
# Test of Experiment F: one dataset with 5 bootstrap samples.
#BSUB -J expFtest
#BSUB -q short
#BSUB -W 1:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/expFtest.%J.%I.out
#BSUB -e logs/expFtest.%J.%I.err
module load matlab/R2025b
TASK=1
MARK=logs/expFtest.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_expF_fits(1, 'B', 5); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
