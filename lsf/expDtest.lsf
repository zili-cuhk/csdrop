#!/bin/bash
# Smoke test for Experiment E: one replicate at n=600 and one at n=5000 (timing).
#BSUB -J expDtest
#BSUB -q short
#BSUB -W 2:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/expDtest.%J.out
#BSUB -e logs/expDtest.%J.err
module load matlab/R2025b
matlab -nodisplay -nosplash -singleCompThread -batch \
  "addpath(genpath('matlab')); run_expD_fits(1, 'reps', 1); run_expD_fits(3, 'reps', 1)"
