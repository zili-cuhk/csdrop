#!/bin/bash
# Experiment F: bootstrap Imbens-Manski coverage; 4 scenarios x 200 reps, B = 100, tau in {0, 0.25, 0.5}.
#BSUB -J expF[1-800]
#BSUB -q medium
#BSUB -W 8:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/expF.%J.%I.out
#BSUB -e logs/expF.%J.%I.err
module load matlab/R2025b
TASK=${LSB_JOBINDEX:-1}
MARK=logs/expF.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_expF_fits($TASK); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
