#!/bin/bash
# Experiment E, moderate signals: n in {600,2000,5000} x 200 reps; 80 tasks.
#BSUB -J expDm[1-80]
#BSUB -q medium
#BSUB -W 8:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/expDm.%J.%I.out
#BSUB -e logs/expDm.%J.%I.err
module load matlab/R2025b
TASK=${LSB_JOBINDEX:-1}
MARK=logs/expDm.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_expD_fits($TASK, 'signal', 'moderate'); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
