#!/bin/bash
# HRS application: index 1 = full data, 2..101 = 200 bootstrap samples in chunks of 2.
# Frank copula over Kendall's tau in {-0.2, 0, 0.2, 0.4, 0.6}; CIFs at 2, 5, 10 and 15 years.
# Run after hrsprep. Check one task first: bsub -J "hrsboot[1]" < lsf/hrsboot.lsf
#BSUB -J hrsboot[1-101]
#BSUB -q medium
#BSUB -W 24:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/hrsboot.%J.%I.out
#BSUB -e logs/hrsboot.%J.%I.err
module load matlab/R2025b
TASK=$((LSB_JOBINDEX - 1))
MARK=logs/hrsboot.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_tcga_boot($TASK, 'data', 'application/hrs/data/hrs_main.csv', 'cutsfile', 'application/hrs/data/hrs_cuts.csv', 'idxfile', 'application/hrs/data/none.csv', 'out', 'hrs_boot', 'tauGrid', [-0.2 0 0.2 0.4 0.6], 'times', [2 5 10 15], 'chunk', 2); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
