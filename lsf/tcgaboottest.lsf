#!/bin/bash
# Test: full-data run only (task 0). Compare with matlab/app/tcga_path_expected_python.txt.
#BSUB -J tcgaboottest
#BSUB -q short
#BSUB -W 0:30
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/tcgaboottest.%J.out
#BSUB -e logs/tcgaboottest.%J.err
module load matlab/R2025b
MARK=logs/tcgaboottest.done
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_tcga_boot(0); T = readtable('results/tcga_boot/boot_0000.csv', 'TextType', 'string'); disp(T(:, {'tau','status','sup_event1','sup_event2','sup_dropout','F1_t1','F1_t2','F1_t3','F2_t1','F2_t2','F2_t3','seconds'})); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "test finished"
