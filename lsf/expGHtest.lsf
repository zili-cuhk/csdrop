#!/bin/bash
# Smoke test for Experiments G and H: one replication each (G with B = 10),
# written to results/expGtest and results/expHtest. Check the seconds column.
#BSUB -J expGHtest
#BSUB -q medium
#BSUB -W 4:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/expGHtest.%J.out
#BSUB -e logs/expGHtest.%J.err
module load matlab/R2025b
time matlab -nodisplay -nosplash -singleCompThread -batch \
  "addpath(genpath('matlab')); run_expF_fits(1, 'tag', 'expGtest', 'B', 10, 'tauGrid', [0.4 0.45 0.5], 'taus', 0.5)"
time matlab -nodisplay -nosplash -singleCompThread -batch \
  "addpath(genpath('matlab')); run_expF_fits(1, 'tag', 'expHtest', 'B', 0, 'tauGrid', 0:0.025:0.5, 'n', [600 1000])"
cut -d, -f1-13 results/expGtest/expGtest_A15_0001.csv
cut -d, -f1-5,26-29 results/expHtest/expHtest_A14_0001.csv
