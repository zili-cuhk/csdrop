#!/bin/bash
# Experiment G (near ties, Theorem 4(v)): the two n = 600, p = 10, tau0 = 0.5 cells
# x 200 reps, B = 100, grid {0.4, 0.45, 0.5}. Summarize with analysis/agg_expF.py results/expG.
#BSUB -J expG[1-400]
#BSUB -q medium
#BSUB -W 8:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/expG.%J.%I.out
#BSUB -e logs/expG.%J.%I.err
module load matlab/R2025b
TASK=$((${LSB_JOBINDEX:-1} + ${OFFSET:-0}))
MARK=logs/expG.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_expF_fits($TASK, 'tag', 'expG', 'tauGrid', [0.4 0.45 0.5], 'taus', 0.5); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
