#!/bin/bash
# TCGA-LUAD bootstrap with the five-cutpoint partition (2.6, 7.5, 12, 18, 30 months).
#BSUB -J tcgabootp5[1-41]
#BSUB -q short
#BSUB -W 2:00
#BSUB -n 1
#BSUB -M 8GB
#BSUB -R "rusage[mem=8GB]"
#BSUB -o logs/tcgabootp5.%J.%I.out
#BSUB -e logs/tcgabootp5.%J.%I.err
module load matlab/R2025b
TASK=$((LSB_JOBINDEX - 1))
MARK=logs/tcgabootp5.done.$TASK
rm -f $MARK
matlab -nodisplay -nosplash -singleCompThread -batch "addpath(genpath('matlab')); run_tcga_boot($TASK, 'cuts', [2.646546339 7.489232995 12 18 30], 'tag', 'p5'); fclose(fopen('$MARK','w'));" &
PID=$!
while kill -0 $PID 2>/dev/null; do
  if [ -f $MARK ]; then sleep 30; kill -9 $PID 2>/dev/null; break; fi
  sleep 20
done
echo "task $TASK finished"
